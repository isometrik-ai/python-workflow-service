# Test environment configuration
PYTHONPATH=src
ENVIRONMENT=test

# ------------- app settings -------------
APP_NAME="Work Order Service"
APP_DESCRIPTION="FastAPI work-order service starter"
APP_VERSION="1.0.0"
PORT=8081
RELOAD=false
SERVICE_URL="http://localhost:8080"
LOG_LEVEL=INFO

# ------------- postgres (engine is lazy; startup skips external services in test mode) -------------
POSTGRES_URI=sqlite+aiosqlite:///:memory:
POSTGRES_SCHEMA=fm

# ------------- redis (in-memory rate limiting is used when ENVIRONMENT=test) -------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_RATE_LIMIT_DB=1
REDIS_URL=redis://localhost:6379/0

# ------------- platform settings -------------
RATE_LIMIT_PER_MINUTE=1000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
USER_AUTH_ROLE=["user"]
ADMIN_AUTH_ROLE=["admin"]
GUEST_AUTH_ROLE=["guest"]
