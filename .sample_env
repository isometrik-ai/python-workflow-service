PYTHONPATH=src

# ------------- app settings -------------
APP_NAME="Work Order Service"
APP_DESCRIPTION="FastAPI work-order service with health checks and platform scaffolding"
APP_VERSION="1.0.0"
PORT=8080
RELOAD=false
CONTACT_NAME="Rahul Sharma"
CONTACT_EMAIL="rahul@3embed.com"
LICENSE_NAME="MIT"
SERVICE_URL="http://localhost:8080"
LOG_LEVEL=INFO
ENVIRONMENT=local

# ------------- database settings -------------
POSTGRES_URI=postgresql+asyncpg://postgres:password@postgres:5432/work_order_service
POSTGRES_SCHEMA=fm
POSTGRES_DB=work_order_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ------------- redis settings -------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0
REDIS_RATE_LIMIT_DB=1
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1

# ------------- work order service settings -------------
WOM_SCHEDULER_ENABLED=true
WOM_SCHEDULER_INTERVAL_MINUTES=60
# Embedded workers (true = run inside the API process; false = use separate worker containers)
WOM_EMBEDDED_SCHEDULER=true
WOM_EMBEDDED_WEBHOOK_WORKER=true
WOM_WEBHOOK_WORKER_INTERVAL_SECONDS=5
WOM_WEBHOOK_WORKER_BATCH_SIZE=50
WOM_INTERNAL_SERVICE_TOKEN=change-me-internal-token
USER_SERVICE_BASE_URL=http://localhost:5000

# ------------- object storage (Phase 5 presigned uploads) -------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_MEDIA_URL=

# ------------- House of Apps CRM (vendor integration) -------------
HOA_LICENSE_KEY=
HOA_APP_SECRET=
HOA_BASE_URL=

# ------------- api platform settings -------------
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://localhost:5173"]

# ------------- auth roles (future route guards) -------------
USER_AUTH_ROLE=["user"]
ADMIN_AUTH_ROLE=["admin"]
GUEST_AUTH_ROLE=["guest"]
